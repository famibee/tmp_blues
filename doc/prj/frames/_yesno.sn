	[return cond=const.sn.frm.yesno]

	[add_frame id=yesno src=_yesno visible=false]
	[event key='dom=yesno:#ok' label=*y global=true]
	[event key='dom=yesno:#close' label=*cancel global=true]

[let_ml name=dicUI]
	{
		"ja": {
			"ok"	: "了解",
			"cancel": "キャンセル",
			"dontask": "次からこの確認をしない"
		},
		"es": {
			"ok"	: "entendido",
			"cancel": "Cancelar",
			"dontask": "No volver a preguntar"
		},
		"en": {
			"ok"	: "ok",
			"cancel": "cancel",
			"dontask": "Don't ask again"
		},
		"cn": {
			"ok"	: "收到",
			"cancel": "取消",
			"dontask": "不再询问"
		},
		"ct": {
			"ok"	: "收到",
			"cancel": "取消",
			"dontask": "不再詢問"
		}
	}
[endlet_ml]
	[set_frame id=yesno var_name=val_ui text=&dicUI]

[macro name=ask_ync
	sum='プレイヤー意志確認\nプレイヤーに「はい」「いいえ」等の二択で確認を行なう'
	detail='プレイヤーが押下した結果をtmp:_yesnoに「y」か「n」で返す'

	%mes='String||プレイヤーに質問したい文言'
	%remember_key?='キー名|毎回確認する|指定すると「次からこの確認をしない」チェックを表示し、\nチェック時は答え（y/n）を sys:sn.dontAsk.キー名 へ記憶して次回以降スキップする。\n記憶の消去は設定画面の「確認ダイアログをリセット」（_config.sn *resetDontAsk）'
]
	[let name=_ry_rk text=%remember_key|'']
	; 「次から確認しない」で答えを記憶済みなら、ダイアログを出さず即座にその答えを返す。
	;	（dontAsk 未設定キーは undefined。text= には出さず cond= の比較でのみ触る）
	;	抜ける前に通常フローの *exit と同じイベント再有効化を通す：呼び元
	;	（_submenu.sn *title 等）は「ask_ync がイベントを有効化して返す」前提のため。
	[let name=_ry_hit text="&_ry_rk != '' && (sys:sn.dontAsk[_ry_rk] == 'y' || sys:sn.dontAsk[_ry_rk] == 'n')"]
	[let name=_yesno text='y' cond="_ry_hit && sys:sn.dontAsk[_ry_rk] == 'y'"]
	[let name=_yesno text='n' cond="_ry_hit && sys:sn.dontAsk[_ry_rk] == 'n'"]
	[enable_event enabled=true cond=_ry_hit]
	[enable_event enabled=true layer=mes_sysmenu cond=_ry_hit]
	[set_focus to=null cond=_ry_hit]
	[return cond=_ry_hit]

	&tmpGameState = isGameState

	[enable_event enabled=false]
	[enable_event enabled=false layer=mes_sysmenu]
	&isGameState = false
	&save:sn.doRecLog = false

	[clear_event]

	; 最新値で更新
	[let name=pic text=%pic|'']
	[set_frame id=yesno var_name=val_dic text=#&'{"mes":"$mp:mes","pic":"$pic"}'#]
	[set_frame id=yesno var_name=val_ui_lang text=&lang]
	[set_frame id=yesno var_name=val_rk text=&_ry_rk]
	[let_frame id=yesno var_name=val2ctrl function=true]

	[frame id=yesno visible=true float=true]

	&_yesno = 'n'

	[event key=y label=*y]
	[event key=n label=*cancel]
	[event key=s label=*cancel]
	[event key=l label=*cancel]
	[event key=rightclick label=*cancel]
	[event key=meta label=*cancel]
	[event key=control label=*cancel]
	[event key=delete label=*cancel]
	[event key=backspace label=*cancel]
	[event key=shift label=*cancel]
	[event key=end label=*cancel]
	[event key=escape label=*cancel]
	[event key=sn:chgNavLang label=*chgNavLang call=true]
[s]

*chgNavLang
	[call label=*exit]

	[call fn=ext_lang]
	[reload_script cond=isGameState]
[return]


*y	&_yesno = 'y'
	[se fn=&sysse_ok2 buf=SYS]
	[jump label=*exit]
*cancel
	[se fn=&sysse_cancel buf=SYS]
*exit
	; 「次からこの確認をしない」チェック時は、今の答え（y/n）を記憶する
	[let_frame id=yesno var_name=val_dontask]
	[let name="&'sys:sn.dontAsk.'+ _ry_rk" text=&_yesno cond="_ry_rk != '' && const.sn.frm.yesno.val_dontask"]

	[frame id=yesno visible=false]

	[enable_event enabled=true]
	[enable_event enabled=true layer=mes_sysmenu]
	&isGameState = tmpGameState
	&save:sn.doRecLog = tmpGameState
	[set_focus to=null]
[endmacro]

[return]
